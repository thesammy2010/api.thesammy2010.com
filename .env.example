# Application configuration
GOOGLE_CLIENT_ID=
ENVIRONMENT=local
PORT=8000

# The Google Sheet the go-heavier data is loaded from, and a service account
# with read access to it, base64 encoded
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Postgres. Locally this is the container from docker-compose; on Fly it comes
# from the app's secrets rather than from a file
DATABASE_URL=postgres://api:password@localhost:5432/api_thesammy2010_com
POSTGRES_USER=api
POSTGRES_PASSWORD=
POSTGRES_DB=api_thesammy2010_com
POSTGRES_PORT=5432

DEFAULT_DB_PAGE_SIZE=50
